  end
  if((!campaign) && inside(1000,57,48,23))begin
   text_valid=1;compact_text=0;text_x=1000;text_y=61;text_width=4;text_pitch=12;text_height=14;message={percent4(charge_percent),224'd0};text_ink=24'h7fe3ec;
  end
  if((!campaign) && inside(478,94,70,18))begin
   text_valid=1;compact_text=1;text_x=478;text_y=97;text_width=5;text_pitch=12;text_height=14;message={"SCORE",216'd0};text_ink=24'he6f0f7;
  end
  if((!campaign) && inside(566,92,144,24))begin
   text_valid=1;compact_text=1;text_x=566;text_y=97;text_width=6;text_pitch=12;text_height=14;message={bcd6(score_bcd),208'd0};text_ink=24'he6f0f7;
  end
  if((!campaign) && inside(752,94,70,18))begin
   text_valid=1;compact_text=1;text_x=752;text_y=97;text_width=5;text_pitch=12;text_height=14;message={"LINES",216'd0};text_ink=24'hffc15b;
  end
  if((!campaign) && inside(848,92,144,24))begin
   text_valid=1;compact_text=1;text_x=848;text_y=97;text_width=6;text_pitch=12;text_height=14;message={bcd6(lines_bcd),208'd0};text_ink=24'hffc15b;
  end
  if((!campaign) && inside(998,390,84,14))begin
   text_valid=1;compact_text=1;text_x=999;text_y=390;text_width=7;text_pitch=12;text_height=14;message={"RESERVE",200'd0};text_ink=24'h7fe3ec;
  end
  if((!campaign) && inside(1006,438,72,21))begin
   text_valid=1;compact_text=1;text_x=1006;text_y=438;text_width=4;text_pitch=18;text_height=21;message={percent4(reserve_percent),224'd0};text_ink=reserve_alarm==2?24'hd8442e:reserve_alarm==1?24'hffc15b:24'h7fe3ec;
  end
  if((!campaign) && inside(1010,500,60,14))begin
   text_valid=1;compact_text=1;text_x=1011;text_y=500;text_width=5;text_pitch=12;text_height=14;message={"POWER",216'd0};text_ink=24'he6f0f7;
  end
  if((!campaign) && inside(992,544,96,14))begin
   text_valid=1;compact_text=1;text_x=reserve_alarm==2?993:reserve_alarm==1?1023:1005;text_y=544;text_width=8;text_pitch=12;text_height=14;message=reserve_alarm==2?{"CRITICAL",192'd0}:reserve_alarm==1?{"LOW",232'd0}:{"STABLE",208'd0};text_ink=reserve_alarm==2?24'hd8442e:reserve_alarm==1?24'hffc15b:24'h7fe3ec;
  end
  // Graphical landing assistance. No heading, status words or quota numerals.
  if(!duo)begin
   hx=x-1040;hy=y-166;
   if(inside(1026,157,28,18) &&
      (((x==1026 || x==1053) && (y<162 || y>169)) ||
       ((y==157 || y==174) && (x<1032 || x>1047))))color=hint_ink;
   if(hx*hx+hy*hy<=9)color=hint_ink;
   // Solid falling piece, dashed vertical path, and matching hollow landing.
   if(inside(hint_left,202,hint_cols*12,24))begin
    hc=(x-hint_left)/12;hr=(y-202)/12;hx=(x-hint_left)%12;hy=(y-202)%12;
    if(hint_mino(hint_type,hc,hr) && hx<10 && hy<10)begin
     color=hint_ink;
     if(hx==0 || hy==0)color=hint_active?24'hcbfbff:24'h7596a8;
    end
   end
   if(x>=1038 && x<1040 && y>=232 && y<246 && y%6<3)color=hint_ink;
   if(y>=243 && y<=250 && x>=1039-(250-y)/2 && x<=1039+(250-y)/2)color=hint_ink;
   if(inside(hint_left,258,hint_cols*12,24))begin
    hc=(x-hint_left)/12;hr=(y-258)/12;hx=(x-hint_left)%12;hy=(y-258)%12;
    if(hint_mino(hint_type,hc,hr) && hx<10 && hy<10 &&
       (hx==0 || hx==9 || hy==0 || hy==9))color=hint_active?24'hffe39c:24'h3c5364;
   end
   if(inside(1002,285,76,2))color=hint_active?24'h7fe3ec:24'h30495d;
   if((x==1002 || x==1077) && y>=280 && y<287)color=hint_ink;
   // Available, consumed and unopened campaign capacity is read from the budget.
   if(campaign)begin
    for(i=0;i<4;i=i+1)begin
     if(inside(1006+i*18,292,10,6))begin
      if(i<hint_quota)color=24'h35e0f5;
      else if(x==1006+i*18 || x==1015+i*18 || y==292 || y==297)
       color=i<hint_capacity?(hint_active?24'hffe39c:24'h607d91):24'h243949;
      else color=24'h06121d;
     end
    end
    if(hint_active && inside(995,301,90,2))
     color=(x-995)*720<hint_life*90?24'h7fe3ec:24'h203747;
   end else begin
    // Linked loops are the unlimited-use symbol; no FREE text or fake quota.
    hx=x-1040;hy=y-295;hd=(hx<0?hx+7:hx-7);
    if(inside(1026,290,28,10) && hd*hd*16+hy*hy*49<=784 && hd*hd*16+hy*hy*49>=300)
     color=hint_ink;
   end
  end
  end
  if((choose) && inside(212,88,310,42))begin
   text_valid=1;compact_text=1;text_x=212;text_y=88;text_width=7;text_pitch=30;text_height=35;message={"CORE-07",200'd0};text_ink=24'he6f0f7;
  end
  if((choose) && inside(748,100,450,24))begin
   text_valid=1;compact_text=1;text_x=748;text_y=100;text_width=11;text_pitch=18;text_height=21;message=ship_select?{"SELECT SHIP",168'd0}:{"SELECT MODE",168'd0};text_ink=24'h7fe3ec;
  end
  if((choose) && inside(232,188,420,30))begin
   text_valid=1;compact_text=1;text_x=232;text_y=188;text_width=11;text_pitch=20;text_height=28;message=ship_select?{"SHIP ",decimal2(level_id+1),200'd0}:{"CORE REPAIR",168'd0};text_ink=24'h7fe3ec;
  end
  if((choose && !ship_select) && inside(232,478,420,18))begin
   text_valid=1;compact_text=1;text_x=232;text_y=478;text_width=19;text_pitch=12;text_height=14;message={"RECONNECT / REBUILD",104'd0};text_ink=24'he6f0f7;
  end
  if((choose && !ship_select) && inside(232,510,430,18))begin
   text_valid=1;compact_text=1;text_x=232;text_y=510;text_width=20;text_pitch=12;text_height=14;message={"STABILIZE / RECHARGE",96'd0};text_ink=24'he6f0f7;
  end
  if((choose && ship_select) && inside(232,478,300,18))begin
   text_valid=1;compact_text=1;text_x=232;text_y=478;text_width=13;text_pitch=12;text_height=14;message={"CHARGE TARGET",152'd0};text_ink=24'h7fe3ec;
  end
  if((choose && ship_select) && inside(610,478,60,18))begin
   text_valid=1;compact_text=1;text_x=610;text_y=478;text_width=2;text_pitch=16;text_height=14;message={decimal2(mode_target(duo,level_id)),240'd0};text_ink=24'h7fe3ec;
  end
  if((choose && ship_select) && inside(232,510,300,18))begin
   text_valid=1;compact_text=1;text_x=232;text_y=510;text_width=6;text_pitch=12;text_height=14;message={"DEBRIS",208'd0};text_ink=24'hffc15b;
  end
  if((choose && ship_select) && inside(610,510,60,18))begin
   text_valid=1;compact_text=1;text_x=610;text_y=510;text_width=2;text_pitch=16;text_height=14;message={decimal2(mode_total(duo,level_id)),240'd0};text_ink=24'hffc15b;
  end
  if((choose && ship_select) && inside(232,542,300,18))begin
   text_valid=1;compact_text=1;text_x=232;text_y=542;text_width=11;text_pitch=12;text_height=14;message={"START SPEED",168'd0};text_ink=24'he6f0f7;
  end
  if((choose && ship_select) && inside(610,542,60,18))begin
   text_valid=1;compact_text=1;text_x=610;text_y=542;text_width=3;text_pitch=16;text_height=14;message={8'd49+mode_initial(duo,level_id),8'd47,8'd56,232'd0};text_ink=24'he6f0f7;
  end
  if((choose) && inside(230,584,432,18))begin
   text_valid=1;compact_text=1;text_x=230;text_y=584;text_width=25;text_pitch=12;text_height=14;message=ship_select?(duo?{"DUO CAMPAIGN",160'd0}:{"SOLO CAMPAIGN",152'd0}):{"ORBITAL RECOVERY TERMINAL",56'd0};text_ink=24'h7fe3ec;
  end
  if((choose) && inside(768,584,432,18))begin
   text_valid=1;compact_text=1;text_x=768;text_y=584;text_width=14;text_pitch=14;text_height=14;message={"SELECT / START",144'd0};text_ink=24'he6f0f7;
  end
  if(choose && inside(768,172,432,374))begin
   menu_row=(y-172)/98;menu_y=172+menu_row*98;
   if(y>=menu_y+18 && y<menu_y+44)begin
    text_valid=1;compact_text=1;text_x=780;text_y=menu_y+18;text_width=13;text_pitch=16;text_height=21;
    text_ink=menu_row==menu_selection?24'h7fe3ec:24'he6f0f7;
    if(ship_select)begin text_width=7;message={"SHIP ",decimal2(menu_row+1),200'd0};end
    else case(menu_row)
     0:begin text_width=12;message={"SOLO ENDLESS",160'd0};end
     1:begin text_width=11;message={"DUO ENDLESS",168'd0};end
     2:begin text_width=13;message={"SOLO CAMPAIGN",152'd0};end
     default:begin text_width=12;message={"DUO CAMPAIGN",160'd0};end
    endcase
   end
   if(y>=menu_y+50 && y<menu_y+68)begin
    text_valid=1;compact_text=1;text_x=780;text_y=menu_y+50;text_width=20;text_pitch=12;text_height=14;text_ink=24'h8fabbf;
    if(ship_select)message={"CHARGE ",decimal2(mode_target(duo,menu_row[1:0])),"  DEBRIS ",decimal2(mode_total(duo,menu_row[1:0])),96'd0};
    else if(menu_row<2)message={"SURVIVE AND RECHARGE",96'd0};
    else message={"RESTORE THE FLEET",120'd0};
   end
  end
  if(choose && inside(565,649,240,28))begin
   text_valid=1;compact_text=1;text_x=565;text_y=649;text_width=12;text_pitch=18;text_height=21;
   message={"SYSTEM READY",160'd0};text_ink=24'h8ecad7;
  end
   if(!choose && comms_visible && inside(dialog_x,160,360,104))begin
    text_valid=0;color=24'h091722;
    if(x<dialog_x+2 || x>=dialog_x+358 || y<162 || y>=262)color=24'h607d91;
    if(x>=dialog_x+5 && x<dialog_x+7 && y>=169 && y<254)color=24'h35e0f5;
    if(y>=172 && y<186)begin
     text_valid=1;text_x=dialog_x+18;text_y=172;text_width=5;text_pitch=12;text_height=14;
     message={"COMMS",216'd0};text_ink=24'h7fe3ec;
    end
    if(y>=202 && y<216 || y>=230 && y<244)begin
     text_valid=1;text_x=dialog_x+18;text_y=y<230?202:230;text_width=26;text_pitch=12;text_height=14;
     message=ref_comms_line(comms_id,y>=230);text_ink=24'he8eef2;
    end
   end

  if(!choose && campaign && credits>=target && inside(476,68,170,1))begin color=24'h7fe3ec;force_paint=1;end
  if(!choose && campaign && debris_left==0 && inside(476,103,174,1))begin color=24'hffc15b;force_paint=1;end
  if(x>=1280 || y>=720)begin color=0;force_paint=1;end
 end
 // Same four clocks as before: the atlas has three reads; the glyph has
 // two. Register their final priority mux on clock four, then story_ui adds one.
 always @(posedge clk or negedge reset_n)begin
  if(!reset_n)begin
   p0<=0;p1<=0;p2<=0;p3<=0;ink0<=0;ink1<=0;ink2<=0;force_pipe<=0;font_lit_q<=0;
  end else begin
   p0<=color;p1<=p0;p2<=p1;
   ink0<=text_ink;ink1<=ink0;ink2<=ink1;
   force_pipe<={force_pipe[1:0],force_paint};font_lit_q<=shared_font_lit;
   p3<=force_pipe[2]?p2:font_lit_q?ink2:basic_hit?basic_rgb:p2;
  end
 end
 assign rgb=p3;
endmodule
