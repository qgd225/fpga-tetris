# RTL 工作区使用 GBK, Git 提交内容转换为 UTF-8; 详见 docs/技术说明/source-encoding.md
*.v text eol=lf working-tree-encoding=GBK
*.vh text eol=lf working-tree-encoding=GBK
*.sv text eol=lf working-tree-encoding=GBK
*.md text eol=lf
*.py text eol=lf
*.tcl text eol=lf
*.xdc text eol=lf
*.bat text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# FPGA 比特流为二进制交付物，禁止换行转换
*.bit binary

# PC 便携启动程序为 Windows 二进制
*.exe binary

# 保留已纳入正式源码的上游 HDL 原始 UTF-8 编码
Tetris.srcs/sources_1/new/audio_info_frame.sv text eol=lf working-tree-encoding=UTF-8
Tetris.srcs/sources_1/new/audio_sample_packet.sv text eol=lf working-tree-encoding=UTF-8
Tetris.srcs/sources_1/new/auxiliary_video_information_info_frame.sv text eol=lf working-tree-encoding=UTF-8
Tetris.srcs/sources_1/new/packet_assembler.sv text eol=lf working-tree-encoding=UTF-8
Tetris.srcs/sources_1/new/tmds_channel.sv text eol=lf working-tree-encoding=UTF-8
docs/reports/hdmi_audio/*.rpt text eol=lf

# Generated asset tables keep deterministic LF bytes.
*.mem text eol=lf
*.json text eol=lf
