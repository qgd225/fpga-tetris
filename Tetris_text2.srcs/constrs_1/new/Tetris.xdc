set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]

set_property IOSTANDARD LVCMOS33 [get_ports Clk]
set_property PACKAGE_PIN Y18 [get_ports Clk]
set_property IOSTANDARD LVCMOS33 [get_ports Reset_key]
set_property PACKAGE_PIN V17 [get_ports Reset_key]

set_property IOSTANDARD TMDS_33 [get_ports hdmi_clk_p]
set_property IOSTANDARD TMDS_33 [get_ports hdmi_clk_n]
set_property IOSTANDARD LVCMOS33 [get_ports hdmi_oe]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_p[0]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_n[0]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_p[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_n[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_p[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_n[2]}]
set_property PACKAGE_PIN W19 [get_ports hdmi_clk_p]
set_property PACKAGE_PIN W20 [get_ports hdmi_clk_n]
set_property PACKAGE_PIN AA21 [get_ports hdmi_oe]
set_property PACKAGE_PIN Y21 [get_ports {hdmi_data_p[0]}]
set_property PACKAGE_PIN Y22 [get_ports {hdmi_data_n[0]}]
set_property PACKAGE_PIN W21 [get_ports {hdmi_data_p[1]}]
set_property PACKAGE_PIN W22 [get_ports {hdmi_data_n[1]}]
set_property PACKAGE_PIN U22 [get_ports {hdmi_data_p[2]}]
set_property PACKAGE_PIN V22 [get_ports {hdmi_data_n[2]}]

set_false_path -from [get_clocks clk_out1_hdmi_pll] -to [get_clocks clk_out2_hdmi_pll]
set_false_path -from [get_clocks clk_out2_hdmi_pll] -to [get_clocks clk_out1_hdmi_pll]

set_property IOSTANDARD LVCMOS33 [get_ports left]
set_property IOSTANDARD LVCMOS33 [get_ports right]
set_property IOSTANDARD LVCMOS33 [get_ports drop]
set_property IOSTANDARD LVCMOS33 [get_ports rotate]
set_property IOSTANDARD LVCMOS33 [get_ports switch]
set_property IOSTANDARD LVCMOS33 [get_ports hold]
set_property PACKAGE_PIN F13 [get_ports left]
set_property PACKAGE_PIN E13 [get_ports right]
set_property PACKAGE_PIN D14 [get_ports drop]
set_property PACKAGE_PIN F16 [get_ports rotate]
set_property PACKAGE_PIN P20 [get_ports switch]
set_property PACKAGE_PIN AB18 [get_ports hold]
set_property PULLUP true [get_ports left]
set_property PULLUP true [get_ports right]
set_property PULLUP true [get_ports drop]
set_property PULLUP true [get_ports rotate]
set_property PULLUP true [get_ports Reset_key]
set_property PULLUP true [get_ports switch]
set_property PULLUP true [get_ports hold]


set_property IOSTANDARD LVCMOS33 [get_ports buzz_main]
set_property PACKAGE_PIN E16 [get_ports buzz_main]
set_property IOSTANDARD LVCMOS33 [get_ports buzz_else]
set_property PACKAGE_PIN A13 [get_ports buzz_else]
