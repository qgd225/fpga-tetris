# ===== Vivado 生成物 =====
*.jou
*.log
.Xil/

# 工程级生成目录（Vivado 按 <project>.<kind> 命名）
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/

# ===== IP 输出产物（保留 .xci 与 ip/ 根下的 .coe）=====
**/sources_1/ip/*/hdl/
**/sources_1/ip/*/sim/
**/sources_1/ip/*/synth/
**/sources_1/ip/*/doc/
**/sources_1/ip/*/misc/
**/sources_1/ip/*/simulation/
**/sources_1/ip/*/*.xml
**/sources_1/ip/*/*.dcp
**/sources_1/ip/*/*_sim_netlist.*
**/sources_1/ip/*/*_stub.*
**/sources_1/ip/*/*.veo
**/sources_1/ip/*/*.vho
**/sources_1/ip/*/*.mif
**/sources_1/ip/*/*.v
**/sources_1/ip/*/*.vh
**/sources_1/ip/*/*.xdc

# ===== 未被工程引用的遗留文件（保留在磁盘，不纳入版本管理）=====
/Tetris.srcs/sources_1/new/clock.v
/Tetris.srcs/sources_1/new/num.v
/Tetris.srcs/sources_1/ip/blk_mem_gen_0/
/Tetris.srcs/sources_1/ip/number/

# ===== Python 缓存 =====
__pycache__/
*.pyc

# ===== 运行时成绩文件 =====
tools/scoreboard.csv

# ===== 仿真台产物 =====
*.wdb

# ===== 手动留存的比特流副本 =====
/Tetris_*.bit
tools/startup_error.log
pc/startup_error.log
pc/scoreboard.csv

# ===== 本地发布压缩包 =====
/Tetris*.zip

/hdmi_audio_*.rpt

# 比特流仅提交 bit/Tetris.bit
*.bit
!/bit/
!/bit/Tetris.bit
/bit/*.tmp

# 当前构建的临时报告；正式验证记录归档至 docs/reports。
/hdmi_audio_*.rpt


# 所有临时运行产物和旧版 bit 仅保留本机。
/temporary/
/bit/*.bit
!/bit/Tetris.bit

# 仿真版本管理仅收录正式测试台；脚本、参考向量和产物在 temporary。
/sim/
!/Tetris.sim/
/Tetris.sim/**
!/Tetris.sim/**/
!/Tetris.sim/**/*tb.v
!/Tetris.sim/**/*tb.sv

# 比赛成品、个人授权信息和RAR仅在本机提交项目录保存。
/提交项/

# 固化镜像遵循bit规则：只纳入最新一份，旧版仅保存在本机。
*.bin
!/bit/Tetris.bin
